# Copy this file to .env and fill in real values for local development.
# (The app reads these from the real environment, e.g. via `docker run -e`,
# your platform's dashboard, or a tool like `direnv`/`godotenv` — this repo
# does not load .env automatically, on purpose, to keep the binary
# dependency-free.)

# Recommended, not strictly required. Secret key used to sign and verify
# JWTs. If unset, the app auto-generates a random secret at startup so it
# still starts cleanly (matching `docker run -p 8080:8080 ticket-system`
# with no -e flags) — but that generated secret is lost on every restart,
# invalidating all previously issued tokens. Set this explicitly for any
# deployment where tokens need to survive a restart or you're running more
# than one instance.
JWT_SECRET=change-me-to-a-long-random-string

# Optional. Port the HTTP server listens on. Defaults to 8080.
PORT=8080

# Optional. How many hours an issued JWT stays valid. Defaults to 24.
JWT_TTL_HOURS=24
